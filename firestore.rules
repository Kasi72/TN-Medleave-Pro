rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLeaveRecord(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.leaveType is string &&
             data.leaveType in ['CL', 'COL', 'IN_LIEU', 'PL', 'GH_WORKED', 'ML', 'RH', 'EL', 'ON_DUTY', 'WEEK_OFF'] &&
             data.dateIso is string &&
             data.dateIso.size() == 10 &&
             data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.year is int &&
             data.year >= 2020 &&
             data.year <= 2035 &&
             data.pairedDateIso is string &&
             data.pairedDateIso.size() <= 20 &&
             data.notes is string &&
             data.notes.size() <= 500 &&
             data.highlightStatus is string &&
             data.highlightStatus in ['NORMAL', 'ALERT_RED', 'VERIFIED_GREEN', 'PENDING_ORANGE'] &&
             data.isHalfDay is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidLeaveEntry(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.leaveType is string &&
             data.leaveType in ['CL', 'COL', 'IN_LIEU', 'PL', 'GH_WORKED', 'ML', 'RH', 'EL', 'ON_DUTY', 'WEEK_OFF'] &&
             data.startDate is string &&
             data.startDate.size() == 10 &&
             data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.endDate is string &&
             data.endDate.size() == 10 &&
             data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (data.totalDays is int || data.totalDays is float) &&
             data.totalDays >= 0.5 &&
             data.totalDays <= 365 &&
             data.status is string &&
             data.status in ['APPROVED', 'PENDING', 'VERIFIED_PAIRED', 'UNPAIRED_ALERT', 'REJECTED', 'CANCELLED'] &&
             data.year is int &&
             data.year >= 2020 &&
             data.year <= 2035 &&
             data.pairedDutyDate is string &&
             data.pairedDutyDate.size() <= 20 &&
             data.reason is string &&
             data.reason.size() <= 500 &&
             data.isHalfDay is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/leave_records/{recordId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(recordId);
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(recordId) &&
                       incoming().keys().hasAll(['userId', 'leaveType', 'dateIso', 'year', 'pairedDateIso', 'notes', 'highlightStatus', 'isHalfDay', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'leaveType', 'dateIso', 'year', 'pairedDateIso', 'notes', 'highlightStatus', 'isHalfDay', 'createdAt', 'updatedAt']) &&
                       isValidLeaveRecord(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(recordId) &&
                       isValidLeaveRecord(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['leaveType', 'dateIso', 'year', 'pairedDateIso', 'notes', 'highlightStatus', 'isHalfDay', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(recordId);
    }

    match /users/{userId}/leave_entries/{entryId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(entryId);
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(entryId) &&
                       incoming().keys().hasAll(['userId', 'leaveType', 'startDate', 'endDate', 'totalDays', 'status', 'year', 'pairedDutyDate', 'reason', 'isHalfDay', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'leaveType', 'startDate', 'endDate', 'totalDays', 'status', 'year', 'pairedDutyDate', 'reason', 'isHalfDay', 'createdAt', 'updatedAt']) &&
                       isValidLeaveEntry(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(entryId) &&
                       isValidLeaveEntry(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['leaveType', 'startDate', 'endDate', 'totalDays', 'status', 'year', 'pairedDutyDate', 'reason', 'isHalfDay', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(entryId);
    }
  }
}
